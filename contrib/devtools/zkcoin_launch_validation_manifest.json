{
  "version": 1,
  "canonical": {
    "lints": [
      "test/lint/lint-zkcoin-public-launch-profile.sh",
      "test/lint/lint-zkcoin-release-infrastructure.sh",
      "test/lint/lint-zkcoin-previous-releases.sh"
    ],
    "configure_flags": [
      "--enable-rust-shielded-verifier",
      "--enable-rust-orchard-verifier"
    ],
    "build_commands": [
      "make -C src clean",
      "make -C src -j\"$JOBS\" litecoind litecoin-cli test/test_litecoin"
    ],
    "unit_tests": [
      "pow_tests",
      "shielded_tests",
      "auxpow_tests",
      "utxo_snapshot_tests"
    ],
    "rust_verifier_commands": [
      "cargo test --locked",
      "cargo test --locked --features verifier-fixture",
      "cargo test --locked --features orchard-verifier",
      "scripts/abi-smoke.sh",
      "scripts/unsupported-consensus-smoke.sh",
      "scripts/fixture-consensus-smoke.sh",
      "scripts/orchard-consensus-smoke.sh"
    ],
    "source_dist_commands": [
      "contrib/devtools/zkcoin_source_dist_smoke.sh"
    ],
    "functional_tests": [
      {
        "path": "test/functional/feature_config_args.py"
      },
      {
        "path": "test/functional/feature_signet.py"
      },
      {
        "path": "test/functional/feature_ltc_snapshot_script.py"
      },
      {
        "path": "test/functional/feature_launch_preflight_script.py"
      },
      {
        "path": "test/functional/feature_shielded_pool.py"
      },
      {
        "path": "test/functional/feature_auxpow_rpc.py"
      },
      {
        "path": "test/functional/rpc_blockchain.py"
      },
      {
        "path": "test/functional/feature_local_ltc_fork_auxpow.py"
      },
      {
        "path": "test/functional/feature_ltc_snapshot_launch.py"
      },
      {
        "path": "test/functional/feature_orchard_auxpow_realproof.py",
        "env": {
          "ZKCOIN_REQUIRE_ORCHARD_VERIFIER": "1"
        }
      }
    ]
  },
  "release_candidate": {
    "wrapper": "contrib/devtools/zkcoin_release_candidate_validation.sh",
    "commands": [
      "contrib/devtools/zkcoin_launch_validation.sh",
      "contrib/devtools/zkcoin_source_dist_realproof_smoke.sh"
    ],
    "source_artifact_commands": [
      "contrib/devtools/zkcoin_source_dist_realproof_smoke.sh"
    ]
  },
  "smoke": {
    "build": {
      "condition": "if [[ \"${SKIP_BUILD:-0}\" != \"1\" ]]; then",
      "commands": [
        "run_step make -C src -j\"$JOBS\" litecoind litecoin-cli test/test_litecoin"
      ]
    },
    "lints": [
      "test/lint/lint-zkcoin-launch-validation.sh",
      "test/lint/lint-zkcoin-public-launch-profile.sh",
      "test/lint/lint-zkcoin-product-identity.sh",
      "test/lint/lint-zkcoin-release-infrastructure.sh",
      "test/lint/lint-zkcoin-previous-releases.sh"
    ],
    "unit_tests": [
      "pow_tests",
      "auxpow_tests",
      "utxo_snapshot_tests"
    ],
    "functional_tests": [
      {
        "path": "test/functional/feature_config_args.py"
      },
      {
        "path": "test/functional/feature_ltc_snapshot_script.py"
      },
      {
        "path": "test/functional/feature_launch_preflight_script.py"
      },
      {
        "path": "test/functional/feature_shielded_pool.py"
      },
      {
        "path": "test/functional/rpc_blockchain.py"
      },
      {
        "path": "test/functional/feature_auxpow_rpc.py"
      },
      {
        "path": "test/functional/feature_local_ltc_fork_auxpow.py"
      },
      {
        "path": "test/functional/feature_signet.py"
      },
      {
        "path": "test/functional/feature_ltc_snapshot_launch.py"
      }
    ],
    "source_dist": {
      "condition": "if [[ \"${RUN_DISTDIR:-1}\" != \"0\" ]]; then",
      "commands": [
        "run_step contrib/devtools/zkcoin_source_dist_smoke.sh"
      ]
    }
  }
}
